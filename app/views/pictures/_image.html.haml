-# This is currently also used on galleries#show

- if picture.plain?
  - begin
    - size ||= :medium
    - image = picture.image_file.variant(Settings.sizes.send(size).to_hash)
    - medium_bad_image = picture.image_file.variant(Settings.sizes.mediumBad.to_hash)

    %picture
      - if size == :small && medium_bad_image.present?
        %source{srcset: url_for(medium_bad_image), media: '(max-width: 768px)'}

      = image_tag image,
        title: picture.to_s,
        alt: picture.to_s,
        loading: 'lazy'

    %noscript
      = image_tag image, title: picture, alt: picture

  - rescue
    .placeholder
      %span.glyphicon.glyphicon-remove-circle
      .title= picture.to_s
      .error.invalid
        Invalid image source

- else
  %div{data: {controller: 'encrypted-image', 'encrypted-image-src-value': url_for(picture.image_file)}}
    .placeholder{data: {'encrypted-image-target': 'placeholder'}}
      %span.glyphicon.glyphicon-lock
      .title= picture.to_s
      .decrypting
        Decrypting...

    %img{data: {'encrypted-image-target': 'image'}, alt: picture.to_s, loading: 'lazy', style: 'display: none'}
