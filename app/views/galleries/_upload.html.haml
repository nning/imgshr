.modal#upload{tabindex: -1, role: 'dialog', aria: {hidden: true, labelledby: 'label_upload'}, data: {controller: 'upload', upload_url_value: gallery_path(@gallery), upload_encrypt_value: @gallery.client_encrypted}}
  .modal-dialog
    .modal-content
      .modal-header
        %button.close{data: {dismiss: 'modal'}}
          %span{aria: {hidden: true}}
            &times;
          %span.sr-only Close
        %h4.modal-title#label_upload Upload pictures

      .modal-body
        .alert.alert-info
          Please choose files for upload...

        %input{type: 'file', multiple: true, data: {'upload-target': 'input', action: 'change->upload#handleFiles'}}

        .upload__list{data: {'upload-target': 'list'}}

        .progress{data: {'upload-target': 'progress'}, style: 'display: none'}
          .progress-bar.progress-bar-striped.active{
            role: 'progressbar',
            'aria-valuenow': 0,
            'aria-valuemin': 0,
            'aria-valuemax': 100,
            style: 'width: 0%',
            data: {'upload-target': 'progressBar'}
          }
            %span.sr-only 0% Complete

      .modal-footer
        %button.btn.btn-success{type: 'button', data: {'upload-target': 'button', action: 'click->upload#upload'}}
          %span.glyphicon.glyphicon-upload
          &nbsp;Upload!
        %button.btn.btn-default{type: 'button', data: {dismiss: 'modal'}}
          %span.glyphicon.glyphicon-remove
          &nbsp;Close
